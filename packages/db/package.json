{
  "name": "@app/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/client.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:studio:local": "drizzle-kit studio --config ./drizzle.local.config.ts",
    "db:studio:remote": "drizzle-kit studio --config ./drizzle.remote.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
